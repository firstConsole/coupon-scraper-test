# Окружение
ENVIRONMENT=local # local | staging | production
DEBUG=false

# Обязательные значения
POSTGRES__PASSWORD=

# Пароль Redis
REDIS__PASSWORD=

# Хранилище снимков карточек
STORAGE__BUCKET=
STORAGE__ACCESS_KEY_ID=
STORAGE__SECRET_ACCESS_KEY=

# Мастер-ключ, которым шифруются чужие платные доступы в базе.
# Минимум 32 байта: openssl rand -base64 48
SECURITY__SECRETS_ENCRYPTION_KEY=

# Обязательные в staging и production
PROXY__ENDPOINT=
PROXY__USERNAME=
PROXY__PASSWORD=
# Страна цели, две буквы по ISO 3166-1. Профиль браузера подстраивается под неё.
PROXY__COUNTRY=
# Хосты, на которые браузеру позволено ходить. Через запятую, без схемы.
SECURITY__ALLOWED_TARGET_HOSTS=
# Ключ провайдера распознавания проверок. Нужен, пока CAPTCHA__ENABLED=true.
CAPTCHA__CAPSOLVER_API_KEY=

# Необязательные
POSTGRES__HOST=localhost
# Порт хоста намеренно не 5432: стенд не должен спорить с другими проектами
# на той же машине. Внутри контейнера Postgres по-прежнему слушает 5432.
POSTGRES__PORT=5442
POSTGRES__USER=coupon_scraper
POSTGRES__DATABASE=coupon_scraper
POSTGRES__POOL_SIZE=10

REDIS__HOST=localhost
# По той же причине, что и у Postgres.
REDIS__PORT=6389
REDIS__DATABASE=0

STORAGE__ENDPOINT_URL=
STORAGE__REGION=auto
STORAGE__PRESIGN_TTL_SECONDS=300
STORAGE__RETENTION_DAYS=90

BROWSER__ENGINE=chromium
BROWSER__HEADLESS=true
BROWSER__POOL_SIZE=4
BROWSER__MAX_PAGES_PER_PROCESS=200
BROWSER__MAX_RSS_MB=2048
BROWSER__NAVIGATION_TIMEOUT_MS=30000

PROXY__REQUEST_BUDGET=15
PROXY__COOLDOWN_SECONDS=900

CAPTCHA__ENABLED=true
CAPTCHA__PRIMARY=capsolver
CAPTCHA__CAPMONSTER_API_KEY=
CAPTCHA__TIMEOUT_SECONDS=120

API__HOST=127.0.0.1
API__PORT=8000
API__ROOT_PATH=
API__REQUEST_TIMEOUT_SECONDS=30

OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_FORMAT=console
OBSERVABILITY__METRICS_ENABLED=true
